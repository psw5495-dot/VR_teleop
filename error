def execute_maximum_grip_test(hand) -> Optional[MaxGripResult]:
    """최대 악력 측정 전체 시퀀스를 실행합니다."""
    interpolation = True
    
    print("\n" + "="*80)
    print("                     최대 악력 측정 시작")
    print("="*80)
    print("⚠️  경고: 로봇이 최대 힘을 발휘합니다. 안전에 주의하세요!")
    print("="*80)
    
    # 1. 초기 안전 전류 설정
    print("\n[1] 안전 전류로 초기화")
    error = hand.set_current_coeff(Config.SAFE_INITIAL_CURRENT_COEFF)
    if not check_error(error, "초기 전류 설정 실패"):
        return None
    time.sleep(Config.DELAY_AFTER_INIT)
    
    # 2. 손 열기 (악력계 배치 시간)
    print("\n[2] 손을 열고 악력계를 배치하세요")
    if not set_hand_open(hand, interpolation):
        return None
    
    print("🔧 악력계나 로드셀을 손바닥에 배치할 시간을 드립니다...")
    for i in range(5, 0, -1):
        print(f"   {i}초 후 측정을 시작합니다...")
        time.sleep(1.0)
    
    # 3. 예비 파지 자세
    print("\n[3] 예비 파지 자세 (악력계 접촉)")
    if not set_grasp_pose(hand, Config.PRE_GRASP_RATIO, interpolation):
        return None
    time.sleep(Config.DELAY_AFTER_PRE_GRASP)
    
    # 4. 최대 파지 자세
    print("\n[4] 최대 파지 자세로 이동")
    if not set_grasp_pose(hand, Config.GRASP_RATIO, interpolation):
        return None
    time.sleep(Config.DELAY_AFTER_GRASP)
    
    # 5. 전류 증가 + 악력 측정
    print("\n[5] 전류를 점진적으로 증가시키며 최대 악력을 측정합니다")
    result = ramp_current_and_measure(hand)
    
    # 6. 최대 악력 유지
    print(f"\n[6] *** 최대 악력 유지 중! 악력계 수치를 확인하세요! ({Config.HOLD_TIME_S}초) ***")
    time.sleep(Config.HOLD_TIME_S)
    
    # 외부 측정 안내 메시지 추가
    result.external_measurement_note = (
        f"이 시점에서 악력계에 표시된 최대값이 실제 최대 악력입니다.\n"
        f"소프트웨어 추정값: {result.max_grip_data.estimated_grip_force:.2f} (참고용)"
    )
    
    # 7. 안전한 해제
    print("\n[7] 측정 완료. 안전하게 힘을 빼고 있습니다...")
    error = hand.set_current_coeff(Config.SAFE_RELEASE_CURRENT_COEFF)
    check_error(error, "전류 감소 실패")
    time.sleep(Config.DELAY_AFTER_RELEASE)
    
    # 8. 손 열기
    print("\n[8] 손을 열어 악력계를 해제합니다")
    set_hand_open(hand, interpolation)
    time.sleep(Config.DELAY_AFTER_OPEN)
    
    print("\n" + "="*80)
    print("                   최대 악력 측정 완료")
    print("="*80)
    
    return result


