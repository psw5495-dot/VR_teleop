#!/usr/bin/env python3
# ~/TeleVision/g1_bridge_node.py
"""
ROS2 → G1 DDS 브릿지 노드 (선택적 관절 제어)
핵심: 오른팔 7개만 활성화, 나머지 28개는 완전 비활성화
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
import time
import subprocess
import numpy as np

# ── 전역 변수 사전 정의 ───────────────────────────────────────
SDK_AVAILABLE = False
LowCmd_ = None
MotorCmd_ = None
ChannelPublisher = None
init_function = None
CRC_AVAILABLE = False
CRC = None

print("🔍 Unitree SDK2 로드 시도 중...")

try:
    from unitree_sdk2py.idl.unitree_hg.msg.dds_ import LowCmd_, MotorCmd_
    from unitree_sdk2py.core.channel import ChannelPublisher, ChannelFactoryInitialize

    # CRC 모듈 로드
    try:
        from unitree_sdk2py.utils.crc import CRC
        CRC_AVAILABLE = True
        print("✅ CRC 모듈 로드 성공 (utils)")
    except ImportError:
        try:
            from unitree_sdk2py.core.crc import CRC
            CRC_AVAILABLE = True
            print("✅ CRC 모듈 로드 성공 (core)")
        except ImportError:
            print("⚠️ CRC 모듈 없음 - 수동 계산 사용")

    init_function = ChannelFactoryInitialize
    SDK_AVAILABLE = True
    print("✅ Unitree SDK2 완전 로드 성공")

except ImportError as e:
    print(f"❌ SDK 로드 실패: {e}")

# ── G1 로봇 사양 ──────────────────────────────────────────────
G1_MOTOR_COUNT = 35

# ⭐️ 제어할 오른팔 7개 관절만 정의
G1_RIGHT_ARM_JOINTS = {
    'right_shoulder_pitch_joint': 15,
    'right_shoulder_roll_joint' : 16,
    'right_shoulder_yaw_joint'  : 17,
    'right_elbow_pitch_joint'   : 18,
    'right_wrist_roll_joint'    : 19,
    'right_wrist_pitch_joint'   : 20,
    'right_wrist_yaw_joint'     : 21,
}

# ── CRC 계산 함수 ─────────────────────────────────────────────
def calculate_crc_manual(data_bytes):
    """수동 CRC32 계산"""
    crc = 0xFFFFFFFF
    for byte in data_bytes:
        crc ^= byte
        for _ in range(8):
            if crc & 1:
                crc = (crc >> 1) ^ 0xEDB88320
            else:
                crc >>= 1
    return crc ^ 0xFFFFFFFF

def set_low_cmd_crc(low_cmd):
    """LowCmd에 올바른 CRC 설정"""
    if CRC_AVAILABLE and CRC is not None:
        try:
            crc_calc = CRC()
            low_cmd.crc = crc_calc.Crc(low_cmd)
            return True
        except Exception as e:
            print(f"SDK CRC 계산 실패: {e}")

    # 수동 CRC 계산
    try:
        data = bytearray()
        data.extend(int(low_cmd.mode_pr).to_bytes(1, 'little'))
        data.extend(int(low_cmd.mode_machine).to_bytes(1, 'little'))
        
        for motor_cmd in low_cmd.motor_cmd:
            data.extend(int(motor_cmd.mode).to_bytes(1, 'little'))
            data.extend(int(motor_cmd.q * 1000).to_bytes(4, 'little', signed=True))
            data.extend(int(motor_cmd.kp * 100).to_bytes(4, 'little', signed=True))
        
        low_cmd.crc = calculate_crc_manual(data) & 0xFFFFFFFF
        return True
    except Exception as e:
        print(f"수동 CRC 계산 실패: {e}")
        low_cmd.crc = 0x12345678  # 더미 CRC
        return False

# ── 메시지 생성 함수 ──────────────────────────────────────────
def create_motor_cmd(mode=0, q=0.0, dq=0.0, tau=0.0, kp=0.0, kd=0.0, reserve=0):
    """MotorCmd_ 생성 (기본값: 비활성화 모드)"""
    return MotorCmd_(
        mode=int(mode),       # 0: 비활성화, 1: 위치제어
        q=float(q),
        dq=float(dq),
        tau=float(tau),
        kp=float(kp),
        kd=float(kd),
        reserve=int(reserve)
    )

def create_low_cmd(motor_cmds):
    """LowCmd_ 생성"""
    return LowCmd_(
        mode_pr=0,
        mode_machine=0,       # 기본 머신 모드
        motor_cmd=motor_cmds,
        reserve=[0, 0, 0, 0],
        crc=0
    )


class G1BridgeNode(Node):
    def __init__(self):
        super().__init__('g1_bridge_node')

        self.cmd_pub = None
        self.low_cmd = None

        # 제어 파라미터
        self.KP = 40.0
        self.KD = 1.0
        
        # 통계
        self.cmd_count = 0
        self.last_log = time.time()

        if SDK_AVAILABLE:
            try:
                self._init_dds()
                self.get_logger().info('✅ G1 실제 제어 모드 활성화')
            except Exception as e:
                self.get_logger().error(f'❌ DDS 초기화 실패: {e}')
                self.get_logger().warn('🔵 시뮬레이션 모드로 전환')
        else:
            self.get_logger().warn('⚠️ SDK 없음 - 시뮬레이션 모드')

        # ROS2 구독
        self.subscription = self.create_subscription(
            JointState, '/g1/arm/joint_commands', self.joint_callback, 10)

        self.get_logger().info('✅ G1 브릿지 노드 시작')
        self.get_logger().info('📡 /g1/arm/joint_commands 구독 중...')
        self.get_logger().info('⚠️  G1이 Low-level SDK 모드인지 확인하세요!')

    def _init_dds(self):
        """DDS 채널 초기화"""
        iface = self._detect_optimal_interface()
        self.get_logger().info(f'🌐 DDS 인터페이스: {iface}')

        # DDS 초기화
        init_function(0, iface)
        self.get_logger().info('✅ DDS 채널 초기화 완료')

        # ⭐️ 핵심: 모든 35개 모터를 비활성화(mode=0)로 초기화
        motor_cmds = []
        for i in range(G1_MOTOR_COUNT):
            motor_cmd = create_motor_cmd(
                mode=0,       # ⭐️ 모든 모터 비활성화
                q=0.0,
                dq=0.0,
                tau=0.0,
                kp=0.0,       # ⭐️ P게인 0 (제어 없음)
                kd=0.0,       # ⭐️ D게인 0 (댐핑 없음)
                reserve=0
            )
            motor_cmds.append(motor_cmd)

        self.low_cmd = create_low_cmd(motor_cmds)
        self.get_logger().info(f'✅ LowCmd 생성 완료 (35개 모터 모두 비활성화)')

        # 퍼블리셔 생성
        self.cmd_pub = ChannelPublisher("rt/lowcmd", LowCmd_)
        self.cmd_pub.Init()
        self.get_logger().info('✅ LowCmd 퍼블리셔 초기화 완료')

    def _detect_optimal_interface(self):
        """네트워크 인터페이스 자동 감지"""
        try:
            result = subprocess.run(
                ['ip', '-o', 'link', 'show'],
                capture_output=True, text=True, timeout=3
            )

            wired_up, wifi_up = [], []

            for line in result.stdout.splitlines():
                parts = line.split()
                if len(parts) < 2:
                    continue

                iface = parts[1].rstrip(':').split('@')[0]
                if iface == 'lo':
                    continue

                is_up = 'UP' in line and 'LOWER_UP' in line
                has_carrier = 'NO-CARRIER' not in line

                if iface.startswith(('enx', 'enp', 'eno', 'ens', 'eth')):
                    if is_up and has_carrier:
                        wired_up.append(iface)
                elif iface.startswith(('wlp', 'wl')):
                    if is_up:
                        wifi_up.append(iface)

            self.get_logger().info(f'🔌 유선: {wired_up} | WiFi: {wifi_up}')

            # 유선 우선, WiFi 대안
            if wired_up:
                self.get_logger().info(f'✅ 유선 선택: {wired_up[0]}')
                return wired_up[0]
            elif wifi_up:
                self.get_logger().warn(f'📶 WiFi 사용: {wifi_up[0]} (유선 권장)')
                return wifi_up[0]

        except Exception as e:
            self.get_logger().warn(f'인터페이스 감지 실패: {e}')

        return "AUTO"

    def joint_callback(self, msg):
        """⭐️ 핵심: 오른팔 관절만 선택적으로 활성화"""
        if self.cmd_pub is None or self.low_cmd is None:
            self._log_simulation(msg)
            return

        try:
            activated_joints = 0

            # ⭐️ 수신된 오른팔 관절만 찾아서 활성화
            for joint_name, motor_idx in G1_RIGHT_ARM_JOINTS.items():
                if joint_name not in msg.name:
                    continue

                j_idx = msg.name.index(joint_name)
                if j_idx >= len(msg.position):
                    continue

                target_q = float(msg.position[j_idx])

                # 안전 범위 체크 (±π 라디안)
                if abs(target_q) > np.pi:
                    self.get_logger().warn(
                        f'⚠️ {joint_name}: {target_q:.3f}rad 범위 초과 (±π)')
                    continue

                # ⭐️ 해당 모터만 위치 제어 모드로 활성화
                motor_cmd = self.low_cmd.motor_cmd[motor_idx]
                motor_cmd.mode = 1          # ⭐️ 위치 제어 활성화
                motor_cmd.q = target_q      # 목표 각도
                motor_cmd.dq = 0.0
                motor_cmd.tau = 0.0
                motor_cmd.kp = self.KP      # P 게인 활성화
                motor_cmd.kd = self.KD      # D 게인 설정

                activated_joints += 1

            if activated_joints == 0:
                return

            # ⭐️ CRC 계산 후 전송
            crc_ok = set_low_cmd_crc(self.low_cmd)
            self.cmd_pub.Write(self.low_cmd)
            self.cmd_count += 1

            # ⭐️ 전송 후 다시 비활성화 (다음 명령까지 간섭 방지)
            for motor_idx in G1_RIGHT_ARM_JOINTS.values():
                motor_cmd = self.low_cmd.motor_cmd[motor_idx]
                motor_cmd.mode = 0    # 비활성화
                motor_cmd.kp = 0.0    # P 게인 제거
                motor_cmd.kd = 0.0    # D 게인 제거

            # 5초마다 상태 로그
            now = time.time()
            if now - self.last_log > 5.0:
                crc_status = "✅" if crc_ok else "⚠️"
                
                # 활성화된 관절 각도 표시
                angles = {}
                for name, idx in G1_RIGHT_ARM_JOINTS.items():
                    if name in msg.name:
                        j_idx = msg.name.index(name)
                        if j_idx < len(msg.position):
                            short_name = name.replace('right_', '').replace('_joint', '')
                            angles[short_name] = f'{msg.position[j_idx]:.3f}'

                self.get_logger().info(
                    f'{crc_status} DDS 전송 {self.cmd_count}회 | '
                    f'활성화: {activated_joints}개 | '
                    f'CRC: 0x{self.low_cmd.crc:08X}'
                )
                self.get_logger().info(f'   관절 각도: {angles}')
                self.last_log = now

        except Exception as e:
            self.get_logger().error(f'❌ joint_callback 에러: {e}')

    def _log_simulation(self, msg):
        """시뮬레이션 모드 로그"""
        now = time.time()
        if now - self.last_log > 3.0:
            if msg.position:
                pos_str = ', '.join(f'{p:.3f}' for p in msg.position[:4])
                self.get_logger().info(f'🔵 [시뮬] 관절 명령: [{pos_str}...]')
            else:
                self.get_logger().info('🔵 [시뮬] 빈 관절 명령 수신')
            self.last_log = now


def main():
    rclpy.init()
    node = G1BridgeNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info('🛑 브릿지 노드 종료')
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
