# =============================================================================
# Device Management
# =============================================================================

def auto_detect_hand() -> Any:
    """Sharpa Wave 디바이스를 자동으로 감지하고 첫 번째 발견된 디바이스에 연결합니다."""
    print("Searching for devices...")

    try:
        manager = SharpaWaveManager.get_instance()
        time.sleep(1.0)

        while True:
            devices = manager.get_all_device_sn()

            if not devices:
                print("No available devices found. Retrying...")
                time.sleep(1.0)
                continue

            print(f"Device found: {devices[0]}")
            return manager.connect(devices[0])

    except Exception as e:
        print(f"Failed to connect to device: {str(e)}")
        raise


def safe_shutdown(hand) -> None:
    """손을 안전하게 해제하고 모든 디바이스 연결을 종료합니다."""
    print("Safe shutdown started")

    try:
        if hand is not None:
            # 전류 감소
            try:
                hand.set_current_coeff(Config.SAFE_RELEASE_CURRENT_COEFF)
            except Exception as e:
                print(f"Warning: failed to reduce current coeff during shutdown: {e}")

            # 손 열기
            try:
                hand.set_joint_position([0.0] * NUM_JOINTS, True)
                time.sleep(1.0)
            except Exception as e:
                print(f"Warning: failed to open hand during shutdown: {e}")

            # 손 정지
            try:
                hand.stop()
            except Exception as e:
                print(f"Warning: failed to stop hand: {e}")

    finally:
        try:
            SharpaWaveManager.get_instance().disconnect_all()
        except Exception as e:
            print(f"Warning: failed to disconnect all: {e}")

    print("Safe shutdown complete")


# =============================================================================
# Initialization
# =============================================================================

def initialize(hand) -> bool:
    """손 제어 파라미터를 초기화합니다."""
    print("Initializing hand...")

    initialization_steps = [
        (hand.set_control_mode, ControlMode.POSITION, "control mode"),
        (hand.set_speed_coeff, Config.INITIAL_SPEED_COEFF, "speed coefficient"),
        (hand.set_current_coeff, Config.SAFE_INITIAL_CURRENT_COEFF, "current coefficient"),
        (hand.set_control_source, ControlSource.SDK, "control source"),
    ]

    for func, param, description in initialization_steps:
        error = func(param)
        if error.code != 0:
            print(f"Failed to set {description}: {error.message}")
            return False

    print("Hand initialization complete")
    return True


# =============================================================================
# Utilities
# =============================================================================

def check_error(error, message: str) -> bool:
    """SDK 에러 객체를 확인하고 실패 시 메시지를 출력합니다."""
    if error.code != 0:
        print(f"{message}: {error.message}")
        return False
    return True


def print_joint_positions_degree(hand) -> None:
    """현재 관절 위치를 도 단위로 출력합니다."""
    error, angles = hand.get_joint_position_degree()

    if error.code != 0:
        print(f"Failed to get joint position(degree): {error.message}")
        return

    print("Current joint angles (deg):")
    for i, angle in enumerate(angles):
        name = JOINT_NAMES[i] if i < len(JOINT_NAMES) else f"Joint {i}"
        print(f"  {i:02d} | {name}: {angle:.2f}")


# =============================================================================
# Pose Generation
# =============================================================================

def make_open_pose() -> List[float]:
    """열린 손 자세를 생성합니다. 고정 관절은 Config.FIXED_JOINT_DEG 값을 유지합니다."""
    pose = [0.0] * NUM_JOINTS

    for joint_index, fixed_deg in Config.FIXED_JOINT_DEG.items():
        pose[joint_index] = math.radians(fixed_deg)

    return pose


def make_grasp_pose(close_ratio: float) -> List[float]:
    """파지 자세를 생성합니다.
    
    Args:
        close_ratio: 0.0 = 완전 열림 (하한각), 1.0 = 완전 닫힘 (상한각)
    
    Returns:
        라디안 단위의 관절 각도 리스트 (길이: NUM_JOINTS)
    """
    close_ratio = max(0.0, min(1.0, close_ratio))
    pose = [0.0] * NUM_JOINTS

    for i in range(NUM_JOINTS):
        if i in Config.FIXED_JOINT_DEG:
            # 고정 관절은 항상 지정된 각도 유지
            pose[i] = math.radians(Config.FIXED_JOINT_DEG[i])
        elif i in Config.SKIP_MOVE_JOINT_INDICES:
            # 움직이지 않을 관절은 0도 유지
            pose[i] = 0.0
        else:
            # 나머지 관절은 close_ratio에 따라 각도 계산
            lo_deg, hi_deg = ANGLE_RANGES[i]
            target_deg = lo_deg + (hi_deg - lo_deg) * close_ratio
            pose[i] = math.radians(target_deg)

    return pose


# =============================================================================
# Hand Motion Commands
# =============================================================================

def set_hand_open(hand, interpolation: bool = True) -> bool:
    """손을 열린 자세로 움직입니다."""
    print("Opening hand...")
    error = hand.set_joint_position(make_open_pose(), interpolation)
    return check_error(error, "Failed to open hand")


def set_grasp_pose(hand, close_ratio: float, interpolation: bool = True) -> bool:
    """손을 지정된 파지 자세로 움직입니다."""
    print(f"Moving to grasp pose. close_ratio={close_ratio:.2f}")
    error = hand.set_joint_position(make_grasp_pose(close_ratio), interpolation)
    return check_error(error, "Failed to set grasp pose")


def ramp_current_gradually(hand) -> bool:
    """전류 계수를 점진적으로 증가시켜 안전하게 강한 힘을 발생시킵니다."""
    start_coeff = Config.RAMP_START_COEFF
    end_coeff = min(Config.FINAL_CURRENT_COEFF, Config.MAX_ALLOWED_CURRENT_COEFF)
    step = Config.RAMP_STEP

    print(f"Ramping current coefficient: {start_coeff:.2f} → {end_coeff:.2f} (step: {step:.2f})")

    current_coeff = start_coeff
    while current_coeff <= end_coeff + 1e-9:
        print(f"  Setting current coefficient: {current_coeff:.2f}")
        error = hand.set_current_coeff(current_coeff)
        if not check_error(error, f"Failed to set current coeff {current_coeff:.2f}"):
            return False

        time.sleep(Config.RAMP_STEP_HOLD_S)
        current_coeff += step

    return True


# =============================================================================
# Main Grasp Sequence
# =============================================================================

def execute_strong_grasp_sequence(hand) -> bool:
    """강한 파지 시퀀스를 실행합니다.
    
    시퀀스:
        1. 낮은 전류로 시작
        2. 손 열기
        3. 예비 파지 자세로 이동
        4. 본 파지 자세로 이동
        5. 전류 점진적 증가
        6. 파지 상태 유지
        7. 전류 감소
        8. 손 열기
    """
    interpolation = True

    print("========== Strong Grasp Sequence Start ==========")

    # 1. 낮은 전류로 시작
    print("[1] Set initial low current")
    error = hand.set_current_coeff(Config.SAFE_INITIAL_CURRENT_COEFF)
    if not check_error(error, "Failed to set initial current coeff"):
        return False
    time.sleep(Config.DELAY_AFTER_INIT)

    # 2. 손 열기
    print("[2] Open hand")
    if not set_hand_open(hand, interpolation):
        return False
    time.sleep(Config.DELAY_AFTER_OPEN)

    # 3. 예비 파지 자세
    print("[3] Move to pre-grasp pose")
    if not set_grasp_pose(hand, Config.PRE_GRASP_RATIO, interpolation):
        return False
    time.sleep(Config.DELAY_AFTER_PRE_GRASP)

    # 4. 본 파지 자세
    print("[4] Move to grasp pose")
    if not set_grasp_pose(hand, Config.GRASP_RATIO, interpolation):
        return False
    time.sleep(Config.DELAY_AFTER_GRASP)

    # 5. 전류 점진적 증가
    print("[5] Increase grip current gradually")
    if not ramp_current_gradually(hand):
        return False

    # 6. 파지 상태 유지
    print(f"[6] Holding object for {Config.HOLD_TIME_S:.1f} seconds")
    time.sleep(Config.HOLD_TIME_S)
    print_joint_positions_degree(hand)

    # 7. 전류 감소
    print("[7] Reduce current before release")
    error = hand.set_current_coeff(Config.SAFE_RELEASE_CURRENT_COEFF)
    check_error(error, "Failed to reduce current coeff")
    time.sleep(Config.DELAY_AFTER_CURRENT_REDUCE)

    # 8. 손 열기
    print("[8] Open hand")
    set_hand_open(hand, interpolation)
    time.sleep(Config.DELAY_AFTER_OPEN)

    print("========== Strong Grasp Sequence Finished ==========")
    return True


# =============================================================================
# Main Execution
# =============================================================================

if __name__ == "__main__":
    print("Sharpa Wave Strong Grasp Example - Starting")
    hand = None

    try:
        print("Sharpa Wave Example - Auto Detect Hand")
        hand = auto_detect_hand()

        if hand is None:
            print("Error: No available device found")
            sys.exit(1)

        print("Sharpa Wave Example - Init Hand Running Mode")
        if not initialize(hand):
            print("Error: Failed to initialize hand")
            sys.exit(1)

        print("Sharpa Wave Example - Start Hand Running Mode")
        hand.start()

        # 시작 전 초기 위치로 이동
        set_hand_open(hand, interpolation=True)
        time.sleep(1.0)

        print("Sharpa Wave Example - Run Strong Grasp")
        
        # 강한 파지 시퀀스 실행 (모든 파라미터는 Config 클래스에서 관리)
        success = execute_strong_grasp_sequence(hand)

        if not success:
            print("Strong grasp sequence failed")
            sys.exit(1)

        print("Sharpa Wave Example - Completed Successfully")

    except KeyboardInterrupt:
        print("\nKeyboardInterrupt received. Stopping safely...")

    except Exception as e:
        print(f"Unexpected error: {e}")

    finally:
        safe_shutdown(hand)
        print("Sharpa Wave Example - Stopped")
