# Data Classes - 측정 결과 구조화
# =============================================================================

class GripMeasurementData:
    """각 측정 스텝의 데이터를 저장하는 클래스"""
    
    def __init__(self, current_coeff: float, timestamp: float):
        self.current_coeff = current_coeff
        self.timestamp = timestamp
        self.joint_angles_deg: Optional[List[float]] = None
        self.joint_torques: Optional[List[float]] = None
        self.joint_currents: Optional[List[float]] = None
        self.estimated_grip_force = 0.0
    
    def calculate_grip_estimate(self) -> float:
        """관절 토크나 전류를 기반으로 악력을 추정합니다."""
        if self.joint_torques:
            # 주요 굴곡 관절의 토크 합산
            active_joints = [i for i in range(NUM_JOINTS) 
                           if i not in Config.SKIP_MOVE_JOINT_INDICES 
                           and i not in Config.FIXED_JOINT_DEG]
            
            total_torque = sum(abs(self.joint_torques[i]) 
                             for i in active_joints 
                             if i < len(self.joint_torques))
            
            # 토크를 악력으로 변환 (근사치, 실제 변환은 링크 길이와 기어비 필요)
            self.estimated_grip_force = total_torque * 0.1  # 임시 변환 계수
            return self.estimated_grip_force
        
        # 토크 데이터가 없으면 전류 계수를 대리 지표로 사용
        self.estimated_grip_force = self.current_coeff * 100  # 임시 스케일링
        return self.estimated_grip_force


class MaxGripResult:
    """최대 악력 측정 결과 전체를 관리하는 클래스"""
    
    def __init__(self):
        self.measurement_data: List[GripMeasurementData] = []
        self.max_grip_data: Optional[GripMeasurementData] = None
        self.stall_detected = False
        self.stall_current_coeff: Optional[float] = None
        self.external_measurement_note = ""
    
    def add_measurement(self, data: GripMeasurementData):
        """측정 데이터를 추가합니다."""
        self.measurement_data.append(data)
    
    def finalize_result(self):
        """측정 완료 후 최대값을 결정합니다."""
        if not self.measurement_data:
            return
        
        # 추정 악력 기준으로 최대값 선정
        self.max_grip_data = max(self.measurement_data, 
                               key=lambda x: x.calculate_grip_estimate())
    
    def print_summary(self):
        """측정 결과를 출력합니다."""
        print("\n" + "="*70)
        print("                   최대 악력 측정 결과")
        print("="*70)
        
        if not self.max_grip_data:
            print("측정 데이터가 없습니다.")
            return
        
        print(f"총 측정 포인트 수: {len(self.measurement_data)}")
        print(f"Stall 감지 여부: {'예' if self.stall_detected else '아니오'}")
        
        if self.stall_detected:
            print(f"Stall 발생 전류 계수: {self.stall_current_coeff:.2f}")
        
        max_data = self.max_grip_data
        print(f"최대 전류 계수: {max_data.current_coeff:.2f}")
        print(f"추정 악력 지표: {max_data.estimated_grip_force:.2f}")
        
        if self.external_measurement_note:
            print(f"\n외부 측정 안내:")
            print(f"{self.external_measurement_note}")
        
        print("="*70)


