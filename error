def auto_detect_hand() -> Any:
    """Sharpa Wave 디바이스를 자동 감지하고 연결합니다."""
    print("디바이스를 검색 중...")
    
    try:
        manager = SharpaWaveManager.get_instance()
        time.sleep(1.0)
        
        while True:
            devices = manager.get_all_device_sn()
            if not devices:
                print("사용 가능한 디바이스가 없습니다. 재시도 중...")
                time.sleep(1.0)
                continue
            
            print(f"디바이스 발견: {devices[0]}")
            return manager.connect(devices[0])
    
    except Exception as e:
        print(f"디바이스 연결 실패: {str(e)}")
        raise


def safe_shutdown(hand) -> None:
    """안전한 시스템 종료를 수행합니다."""
    print("안전 종료 절차 시작...")
    
    try:
        if hand is not None:
            try:
                hand.set_current_coeff(Config.SAFE_RELEASE_CURRENT_COEFF)
                time.sleep(0.5)
            except Exception as e:
                print(f"경고: 전류 감소 실패: {e}")
            
            try:
                hand.set_joint_position([0.0] * NUM_JOINTS, True)
                time.sleep(2.0)
            except Exception as e:
                print(f"경고: 손 열기 실패: {e}")
            
            try:
                hand.stop()
            except Exception as e:
                print(f"경고: 손 정지 실패: {e}")
    
    finally:
        try:
            SharpaWaveManager.get_instance().disconnect_all()
        except Exception as e:
            print(f"경고: 연결 해제 실패: {e}")
    
    print("안전 종료 완료")


