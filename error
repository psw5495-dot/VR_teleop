@dataclass
class TeleopConfig:
    pos_scale: float = 0.3                              # 0.5→0.3 (더 작은 움직임)
    robot_home_pos: Tuple[float, float, float] = (0.35, -0.20, 0.45)
    max_dx: float = 0.08                                # 0.10→0.08
    max_dy: float = 0.08
    max_dz: float = 0.08
    ema_alpha: float = 0.15
    watchdog_timeout_s: float = 2.0                     # ⭐️ 0.3→2.0 (워치독 완화)
    axis_sign: Tuple[float, float, float] = (1.0, -1.0, -1.0)
