from unitree_sdk2py.idl.unitree_hg.msg.dds_ import LowCmd_, LowState_, MotorCmd_


def create_motor_cmd(mode=0, q=0.0, dq=0.0, tau=0.0, kp=0.0, kd=0.0, reserve=0):
    """MotorCmd_ 안전 생성 (7개 필수 인자 완벽 대응)"""
    return MotorCmd_(
        mode=int(mode), q=float(q), dq=float(dq),
        tau=float(tau), kp=float(kp), kd=float(kd), 
        reserve=int(reserve)
    )

def create_empty_low_cmd():
    """LowCmd_ 안전 생성 (5개 필수 인자 완벽 대응)"""
    # 35개 모터 명령 배열 생성 (G1 사양)
    motor_cmds = [create_motor_cmd() for _ in range(35)]
    
    return LowCmd_(
        mode_pr=0,              # uint8: PR 모드
        mode_machine=0,         # uint8: 머신 모드
        motor_cmd=motor_cmds,   # MotorCmd_[35]: 모터 명령 배열
        reserve=[0, 0, 0, 0],   # uint32[4]: 예약 필드
        crc=0                   # uint32: CRC 체크섬
    )

# ⭐️ Helper 함수로 안전하게 초기화
self.low_cmd = create_empty_low_cmd()

