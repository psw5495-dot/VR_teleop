def ramp_current_and_measure(hand) -> MaxGripResult:
    """전류를 점진적으로 증가시키면서 악력을 측정합니다."""
    result = MaxGripResult()
    
    start_coeff = Config.RAMP_START_COEFF
    end_coeff = min(Config.FINAL_CURRENT_COEFF, Config.MAX_ALLOWED_CURRENT_COEFF)
    current_coeff = start_coeff
    
    prev_angles: Optional[List[float]] = None
    stall_count = 0
    
    print(f"\n전류 점진 증가 시작: {start_coeff:.2f} → {end_coeff:.2f}")
    print("각 단계마다 센서 데이터를 수집합니다...")
    
    while current_coeff <= end_coeff + 1e-9:
        print(f"\n[측정] 전류 계수: {current_coeff:.2f}")
        
        # 전류 설정
        error = hand.set_current_coeff(current_coeff)
        if not check_error(error, f"전류 계수 {current_coeff:.2f} 설정 실패"):
            break
        
        # 안정화 대기
        time.sleep(Config.RAMP_STEP_HOLD_S)
        
        # 데이터 수집
        measurement = GripMeasurementData(current_coeff, time.time())
        measurement.joint_angles_deg = get_joint_angles_deg(hand)
        measurement.joint_torques = get_joint_torques(hand)
        measurement.joint_currents = get_joint_currents(hand)
        
        if measurement.joint_angles_deg is None:
            print("경고: 관절 각도 읽기 실패, 다음 스텝으로 진행")
            current_coeff += Config.RAMP_STEP
            continue
        
        # 악력 추정 계산
        grip_estimate = measurement.calculate_grip_estimate()
        print(f"추정 악력 지표: {grip_estimate:.2f}")
        
        result.add_measurement(measurement)
        
        # Stall 감지
        if prev_angles is not None:
            if detect_stall(prev_angles, measurement.joint_angles_deg):
                stall_count += 1
                print(f"Stall 감지됨 ({stall_count}/{Config.STALL_CONFIRM_COUNT})")
                
                if stall_count >= Config.STALL_CONFIRM_COUNT:
                    print("*** 최대 악력에 도달했습니다 (Stall 감지) ***")
                    result.stall_detected = True
                    result.stall_current_coeff = current_coeff
                    break
            else:
                stall_count = 0
        
        prev_angles = measurement.joint_angles_deg
        current_coeff += Config.RAMP_STEP
    
    result.finalize_result()
    return result


def save_measurement_to_csv(result: MaxGripResult) -> None:
    """측정 결과를 CSV 파일로 저장합니다."""
    if not result.measurement_data:
        return
    
    timestamp_str = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"{Config.CSV_DIR}/max_grip_measurement_{timestamp_str}.csv"
    
    try:
        with open(filename, 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            
            # 헤더 작성
            headers = ['timestamp', 'current_coeff', 'estimated_grip_force']
            headers += [f'angle_deg_{i}' for i in range(NUM_JOINTS)]
            
            if result.measurement_data[0].joint_torques:
                headers += [f'torque_{i}' for i in range(NUM_JOINTS)]
            if result.measurement_data[0].joint_currents:
                headers += [f'current_A_{i}' for i in range(NUM_JOINTS)]
            
            writer.writerow(headers)
            
            # 데이터 작성
            for data in result.measurement_data:
                row = [
                    data.timestamp,
                    data.current_coeff, 
                    data.estimated_grip_force
                ]
                row += data.joint_angles_deg
                
                if data.joint_torques:
                    row += data.joint_torques
                if data.joint_currents:
                    row += data.joint_currents
                
                writer.writerow(row)
        
        print(f"\n측정 결과가 저장되었습니다: {filename}")
    
    except Exception as e:
        print(f"CSV 저장 실패: {e}")


