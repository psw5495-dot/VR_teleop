#!/usr/bin/env python3
# ~/TeleVision/g1_bridge_node.py
"""
ROS2 → G1 DDS 브릿지 노드 (LowCmd_ 초기화 문제 완전 해결)
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
import time
import subprocess
import numpy as np

# ── 전역 변수 사전 정의 ───────────────────────────────────────
SDK_AVAILABLE = False
LowCmd_ = None
MotorCmd_ = None
ChannelPublisher = None
init_function = None

print("🔍 Unitree SDK2 로드 시도 중...")

# ── LowCmd_, MotorCmd_ 동시 임포트 (필수) ────────────────────
try:
    from unitree_sdk2py.idl.unitree_hg.msg.dds_ import LowCmd_, MotorCmd_
    print("✅ LowCmd_, MotorCmd_ 로드: unitree_hg 경로")
except ImportError:
    try:
        from unitree_sdk2py.idl.unitree_go.msg.dds_ import LowCmd_, MotorCmd_
        print("✅ LowCmd_, MotorCmd_ 로드: unitree_go 경로")
    except ImportError:
        print("❌ 메시지 타입 로드 실패")
        LowCmd_ = None
        MotorCmd_ = None

# ── ChannelPublisher 임포트 ───────────────────────────────────
if LowCmd_ is not None:
    try:
        from unitree_sdk2py.core.channel import ChannelPublisher
        print("✅ ChannelPublisher 로드 성공")
    except ImportError:
        ChannelPublisher = None

# ── DDS 초기화 함수 탐색 ──────────────────────────────────────
if LowCmd_ is not None and ChannelPublisher is not None:
    try:
        from unitree_sdk2py.core.channel import ChannelFactoryInitialize
        init_function = ChannelFactoryInitialize
        SDK_AVAILABLE = True
        print("✅ 초기화 함수: ChannelFactoryInitialize")
    except ImportError:
        try:
            from unitree_sdk2py.core.channel import InitChannels
            init_function = InitChannels
            SDK_AVAILABLE = True
            print("✅ 초기화 함수: InitChannels")
        except ImportError:
            print("❌ DDS 초기화 함수 없음")

if SDK_AVAILABLE:
    print("🎉 Unitree SDK2 완전 로드 성공!")
else:
    print("⚠️ SDK 로드 실패 → 시뮬레이션 모드")

# ── G1 로봇 사양 ──────────────────────────────────────────────
G1_MOTOR_COUNT = 35  # G1 전체 모터 수

G1_RIGHT_ARM_MOTOR_IDX = {
    'right_shoulder_pitch_joint': 15,
    'right_shoulder_roll_joint' : 16,
    'right_shoulder_yaw_joint'  : 17,
    'right_elbow_pitch_joint'   : 18,
    'right_wrist_roll_joint'    : 19,
    'right_wrist_pitch_joint'   : 20,
    'right_wrist_yaw_joint'     : 21,
}


class G1BridgeNode(Node):
    def __init__(self):
        super().__init__('g1_bridge_node')
        
        self.cmd_pub = None
        self.low_cmd = None
        
        if SDK_AVAILABLE:
            try:
                self._init_dds()
                self.get_logger().info('✅ DDS 연결 완료 - G1 실제 제어 모드')
            except Exception as e:
                self.get_logger().error(f'❌ DDS 초기화 실패: {e}')
                self.get_logger().warn('🔵 시뮬레이션 모드로 전환')
        else:
            self.get_logger().warn('⚠️ SDK 없음 - 시뮬레이션 모드')
        
        # ROS2 구독
        self.subscription = self.create_subscription(
            JointState, '/g1/arm/joint_commands', self.joint_callback, 10)
        
        # 제어 파라미터
        self.KP = 40.0
        self.KD = 1.0
        
        self.cmd_count = 0
        self.last_log = time.time()
        
        self.get_logger().info('✅ G1 브릿지 노드 시작')
        self.get_logger().info('📡 /g1/arm/joint_commands 구독 중...')

    def _init_dds(self):
        """DDS 채널 및 메시지 초기화"""
        
        # ⭐️ 유선 네트워크 우선 선택 (WiFi 대신)
        iface = self._detect_wired_interface()
        self.get_logger().info(f'🌐 선택된 DDS 인터페이스: {iface}')
        
        # DDS 채널 팩토리 초기화
        init_function(0, iface)
        self.get_logger().info('✅ DDS 채널 팩토리 초기화 완료')
        
        # ⭐️ 핵심 수정: LowCmd_ 필수 인자 명시적 전달
        motor_cmds = self._create_motor_commands()
        
        self.low_cmd = LowCmd_(
            mode_pr=0,           # 0: position mode
            mode_machine=0,      # 0: default machine mode  
            motor_cmd=motor_cmds, # MotorCmd_ 배열 (35개)
            reserve=[0, 0, 0, 0], # 예약 필드 (4개 요소)
            crc=0                # CRC 체크섬
        )
        
        self.get_logger().info(f'✅ LowCmd_ 객체 초기화 성공 (모터 {len(motor_cmds)}개)')
        
        # 퍼블리셔 생성
        self.cmd_pub = ChannelPublisher("rt/lowcmd", LowCmd_)
        self.cmd_pub.Init()
        self.get_logger().info('✅ LowCmd 퍼블리셔 초기화 완료')

    def _create_motor_commands(self):
        """MotorCmd_ 배열 안전 생성"""
        motor_cmds = []
        
        for i in range(G1_MOTOR_COUNT):
            try:
                # MotorCmd_ 생성 시도 (버전에 따라 인자 수가 다를 수 있음)
                motor_cmd = MotorCmd_()
                
                # 기본값 설정
                motor_cmd.q   = 0.0
                motor_cmd.dq  = 0.0
                motor_cmd.kp  = 0.0
                motor_cmd.kd  = 0.5
                motor_cmd.tau = 0.0
                
                motor_cmds.append(motor_cmd)
                
            except Exception as e:
                self.get_logger().error(f'❌ MotorCmd_[{i}] 생성 실패: {e}')
                # 실패 시에도 빈 객체라도 추가 (배열 크기 유지)
                motor_cmds.append(None)
        
        return motor_cmds

    def _detect_wired_interface(self):
        """유선 이더넷 인터페이스 우선 감지"""
        try:
            # 활성화된 네트워크 인터페이스 목록 가져오기
            result = subprocess.run(
                ['ip', 'link', 'show', 'up'], 
                capture_output=True, text=True, timeout=3
            )
            
            interfaces = []
            for line in result.stdout.split('\n'):
                if ':' in line and 'UP' in line:
                    iface_name = line.split(':')[1].strip()
                    if iface_name != 'lo':  # loopback 제외
                        interfaces.append(iface_name)
            
            # 1순위: 유선 이더넷 (enp, eno, ens, eth)
            for iface in interfaces:
                if iface.startswith(('enp', 'eno', 'ens', 'eth')):
                    self.get_logger().info(f'🔌 유선 인터페이스 감지: {iface}')
                    return iface
            
            # 2순위: 무선 (wlp, wl) - 유선이 없을 경우
            for iface in interfaces:
                if iface.startswith(('wlp', 'wl')):
                    self.get_logger().warn(f'📶 무선 인터페이스 사용: {iface} (유선 권장)')
                    return iface
            
        except Exception as e:
            self.get_logger().warn(f'인터페이스 감지 실패: {e}')
        
        return "AUTO"

    def joint_callback(self, msg):
        """ROS2 JointState → G1 DDS 명령 변환"""
        if self.cmd_pub is None or self.low_cmd is None:
            self._log_simulation(msg)
            return
        
        try:
            matched_joints = 0
            
            # 관절 이름 → 모터 인덱스 매핑
            for joint_name, motor_idx in G1_RIGHT_ARM_MOTOR_IDX.items():
                if joint_name not in msg.name:
                    continue
                
                j_idx = msg.name.index(joint_name)
                if j_idx >= len(msg.position):
                    continue
                
                target_q = float(msg.position[j_idx])
                
                # 안전 범위 체크 (±π 라디안)
                if abs(target_q) > np.pi:
                    self.get_logger().warn(
                        f'⚠️ {joint_name}: 각도 {target_q:.3f}rad 범위 초과')
                    continue
                
                # 모터 명령 업데이트
                if motor_idx < len(self.low_cmd.motor_cmd):
                    mc = self.low_cmd.motor_cmd[motor_idx]
                    if mc is not None:
                        mc.q   = target_q
                        mc.dq  = 0.0
                        mc.kp  = self.KP
                        mc.kd  = self.KD
                        mc.tau = 0.0
                        matched_joints += 1
            
            if matched_joints == 0:
                return  # 매칭된 관절이 없으면 전송하지 않음
            
            # G1으로 DDS 전송
            self.cmd_pub.Write(self.low_cmd)
            self.cmd_count += 1
            
            # 5초마다 상태 로그
            now = time.time()
            if now - self.last_log > 5.0:
                self.get_logger().info(
                    f'✅ DDS 전송 {self.cmd_count}회 | '
                    f'매칭 관절: {matched_joints}개'
                )
                self.last_log = now
                
        except Exception as e:
            self.get_logger().error(f'❌ joint_callback 에러: {e}')

    def _log_simulation(self, msg):
        """시뮬레이션 모드 로그"""
        now = time.time()
        if now - self.last_log > 3.0:
            if len(msg.position) > 0:
                pos_str = ', '.join(f'{p:.3f}' for p in msg.position[:4])
                self.get_logger().info(f'🔵 [시뮬] 관절 명령: [{pos_str}...]')
            self.last_log = now


def main():
    rclpy.init()
    node = G1BridgeNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info('🛑 브릿지 노드 종료')
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
