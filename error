# Pose Generation & Motion Commands
# =============================================================================

def make_open_pose() -> List[float]:
    """열린 손 자세를 생성합니다."""
    pose = [0.0] * NUM_JOINTS
    for idx, deg in Config.FIXED_JOINT_DEG.items():
        pose[idx] = math.radians(deg)
    return pose


def make_grasp_pose(close_ratio: float) -> List[float]:
    """파지 자세를 생성합니다."""
    close_ratio = max(0.0, min(1.0, close_ratio))
    pose = [0.0] * NUM_JOINTS
    
    for i in range(NUM_JOINTS):
        if i in Config.FIXED_JOINT_DEG:
            pose[i] = math.radians(Config.FIXED_JOINT_DEG[i])
        elif i in Config.SKIP_MOVE_JOINT_INDICES:
            pose[i] = 0.0
        else:
            lo, hi = ANGLE_RANGES[i]
            target_deg = lo + (hi - lo) * close_ratio
            pose[i] = math.radians(target_deg)
    
    return pose


def set_hand_open(hand, interpolation: bool = True) -> bool:
    """손을 엽니다."""
    print("손을 열고 있습니다...")
    error = hand.set_joint_position(make_open_pose(), interpolation)
    return check_error(error, "손 열기 실패")


def set_grasp_pose(hand, close_ratio: float, interpolation: bool = True) -> bool:
    """파지 자세로 이동합니다."""
    print(f"파지 자세로 이동 중... (닫힘 비율: {close_ratio:.2f})")
    error = hand.set_joint_position(make_grasp_pose(close_ratio), interpolation)
    return check_error(error, "파지 자세 설정 실패")


