def initialize(hand) -> bool:
    """손 제어를 초기화합니다."""
    print("손 초기화 중...")
    
    init_steps = [
        (hand.set_control_mode, ControlMode.POSITION, "제어 모드"),
        (hand.set_speed_coeff, Config.INITIAL_SPEED_COEFF, "속도 계수"),
        (hand.set_current_coeff, Config.SAFE_INITIAL_CURRENT_COEFF, "전류 계수"),
        (hand.set_control_source, ControlSource.SDK, "제어 소스"),
    ]
    
    for func, param, desc in init_steps:
        error = func(param)
        if error.code != 0:
            print(f"{desc} 설정 실패: {error.message}")
            return False
    
    print("손 초기화 완료")
    return True


def check_error(error, message: str) -> bool:
    """에러를 체크하고 메시지를 출력합니다."""
    if error.code != 0:
        print(f"{message}: {error.message}")
        return False
    return True


