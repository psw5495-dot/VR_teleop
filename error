    "Pinky MCP Flexion/Extension",
    "Pinky MCP Abduction/Adduction",
    "Pinky PIP Flexion/Extension",
    "Pinky DIP Flexion/Extension",
]
 
 
# Angle ranges in degrees
# Based on Sharpa Wave Range of Motion table
ANGLE_RANGES: List[Tuple[float, float]] = [
    (-5, 105),    # 0  Thumb CMC Flexion/Extension
    (-18, 18),    # 1  Thumb CMC Abduction/Adduction
    (-25, 75),    # 2  Thumb MCP Flexion/Extension
    (-18, 18),    # 3  Thumb MCP Abduction/Adduction
