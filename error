# 1. 실제 설치된 ROS 버전 확인
ls -la /opt/ros/

# 2. Unitree 작업 공간 확인
ls -la /home/unitree/ros2_ws/ 2>/dev/null
ls -la /home/unitree/unitree_ros2/ 2>/dev/null

# 3. 시스템 전체 ROS setup 파일 탐색
find /opt /home -name "setup.bash" 2>/dev/null | grep ros

# 4. 현재 실행 중인 ROS/Unitree 프로세스 확인
ps aux | grep -E "ros|unitree|g1" | grep -v grep

# 5. Unitree SDK2 설치 확인
ls -la /opt/unitree/ 2>/dev/null
find /home/unitree -name "*sdk*" -type d 2>/dev/null
