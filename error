    </div>
    
    <!-- 진단 및 실행 버튼들 -->
    <button class="btn" id="btn-check">🔍 1단계: WebXR 지원 여부 전체 검사</button>
    <button class="btn" id="btn-vr">🥽 2단계: VR 모드 시작 (immersive-vr)</button>
    <button class="btn" id="btn-inline">📱 3단계: 인라인 모드 테스트 (fallback)</button>
    <button class="btn" id="btn-ws">📡 WebSocket 재연결</button>

<script>
// ==========================================
// 로그 시스템
// ==========================================
const logDiv = document.getElementById('log');
const statusDiv = document.getElementById('status');

function log(message, type = 'info') {
    const timestamp = new Date().toLocaleTimeString();
    const logLine = document.createElement('div');
    logLine.className = `log-${type}`;
    logLine.textContent = `[${timestamp}] ${message}`;
    logDiv.appendChild(logLine);
    logDiv.scrollTop = logDiv.scrollHeight;
    console.log(`[${type.toUpperCase()}] ${message}`);
}

log('🚀 진단 시스템 시작', 'ok');
log(`브라우저: ${navigator.userAgent.substring(0, 80)}`, 'info');
log(`현재 주소: ${window.location.href}`, 'info');

// ==========================================
// WebSocket 연결
// ==========================================
let ws = null;

function connectWebSocket() {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${window.location.host}/ws`;
    
    log(`WebSocket 연결 시도: ${wsUrl}`, 'info');
    
    try {
        ws = new WebSocket(wsUrl);
        
        ws.onopen = () => {
            log('✅ WebSocket 연결 성공!', 'ok');
            statusDiv.textContent = '✅ 서버 연결 완료 - 1단계 검사를 시작하세요';
            statusDiv.style.background = 'rgba(76, 175, 80, 0.3)';
        };
        
        ws.onclose = (event) => {
            log(`❌ WebSocket 연결 끊김 (code: ${event.code})`, 'err');
            statusDiv.textContent = '❌ 서버 연결 실패 - 서버를 확인하세요';
            statusDiv.style.background = 'rgba(244, 67, 54, 0.3)';
        };
        
        ws.onerror = () => {
            log('❌ WebSocket 에러 발생', 'err');
        };
        
    } catch (error) {
        log(`❌ WebSocket 생성 실패: ${error.message}`, 'err');
    }
}

// WebSocket 초기 연결
connectWebSocket();

// ==========================================
// 1단계: WebXR 완전 진단
// ==========================================
document.getElementById('btn-check').addEventListener('click', async () => {
    log('=== WebXR 완전 진단 시작 ===', 'info');
    
    // HTTPS 체크 (가장 중요!)
    const isHttps = window.location.protocol === 'https:';
    log(`${isHttps ? '✅' : '❌'} HTTPS 프로토콜: ${window.location.protocol}`, isHttps ? 'ok' : 'err');
    
    if (!isHttps) {
        log('🔴 치명적 오류: HTTP 접속 감지!', 'err');
        log('→ 반드시 https://IP:8443 으로 접속하세요', 'err');
        statusDiv.textContent = '❌ HTTP 접속 - HTTPS 필수!';
        statusDiv.style.background = 'rgba(244, 67, 54, 0.5)';
        return;
    }
    
    // navigator.xr 존재 확인
    if (!('xr' in navigator)) {
        log('❌ navigator.xr 없음 - WebXR 미지원 브라우저', 'err');
        log('→ Meta Quest 내장 "브라우저" 앱을 사용하세요', 'warn');
        log('→ 개발자 모드가 활성화되어 있는지 확인하세요', 'warn');
        statusDiv.textContent = '❌ WebXR 미지원 브라우저';
        return;
    }
    log('✅ navigator.xr 존재 확인', 'ok');
    
    // immersive-vr 지원 확인
    try {
        const vrSupported = await navigator.xr.isSessionSupported('immersive-vr');
        log(`${vrSupported ? '✅' : '❌'} immersive-vr 지원: ${vrSupported}`, vrSupported ? 'ok' : 'err');
        
        if (!vrSupported) {
            log('→ Quest 개발자 모드 확인 필요', 'warn');
            log('→ Quest 설정 > 시스템 > 개발자 > USB 디버깅 활성화', 'warn');
        }
    } catch (error) {
        log(`❌ immersive-vr 확인 실패: ${error.message}`, 'err');
    }
    
    // inline 모드 확인 (fallback)
    try {
        const inlineSupported = await navigator.xr.isSessionSupported('inline');
        log(`${inlineSupported ? '✅' : '❌'} inline 모드 지원: ${inlineSupported}`, inlineSupported ? 'ok' : 'warn');
    } catch (error) {
        log(`❌ inline 모드 확인 실패: ${error.message}`, 'err');
    }
    
    // WebSocket 상태 확인
    const wsStatus = ws ? ['연결중', '연결됨', '종료중', '종료됨'][ws.readyState] : '없음';
    const wsOk = ws && ws.readyState === WebSocket.OPEN;
    log(`${wsOk ? '✅' : '❌'} WebSocket 상태: ${wsStatus}`, wsOk ? 'ok' : 'err');
    
    // 종합 판정
    log('=== 진단 완료 ===', 'info');
    const allGood = isHttps && ('xr' in navigator) && wsOk;
    
    if (allGood) {
        log('🎉 모든 기본 요구사항 충족! 2단계 VR 시작을 시도하세요', 'ok');
        statusDiv.textContent = '✅ 진단 통과 - VR 시작 가능';
        statusDiv.style.background = 'rgba(76, 175, 80, 0.4)';
    } else {
        log('⚠️ 문제 발견 - 위 에러들을 먼저 해결하세요', 'warn');
        statusDiv.textContent = '⚠️ 문제 발견 - 로그 확인 필요';
        statusDiv.style.background = 'rgba(255, 152, 0, 0.4)';
    }
});

// ==========================================
// Three.js 렌더러 초기화
// ==========================================
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 100);
const renderer = new THREE.WebGLRenderer({ antialias: true });

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.xr.enabled = true;
renderer.setClearColor(0x1a1a2e);
renderer.domElement.style.display = 'none';
document.body.appendChild(renderer.domElement);

// 씬 구성
const gridHelper = new THREE.GridHelper(10, 10, 0x888888, 0x444444);
scene.add(gridHelper);

const ambientLight = new THREE.AmbientLight(0x404040, 0.6);
const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
directionalLight.position.set(2, 4, 2);
scene.add(ambientLight);
scene.add(directionalLight);

// 컨트롤러 설정
const rightController = renderer.xr.getController(0);
const leftController = renderer.xr.getController(1);

// 컨트롤러 시각화
const rightBox = new THREE.Mesh(
    new THREE.BoxGeometry(0.05, 0.05, 0.15),
    new THREE.MeshStandardMaterial({ color: 0x00ff00 })
);
const leftBox = new THREE.Mesh(
    new THREE.BoxGeometry(0.05, 0.05, 0.15),
    new THREE.MeshStandardMaterial({ color: 0x0088ff })
);

rightController.add(rightBox);
leftController.add(leftBox);
scene.add(rightController);
scene.add(leftController);

// ==========================================
// XR 세션 시작 공통 함수
// ==========================================
async function startXRSession(mode) {
    log(`🎯 XR 세션 시작 시도: ${mode}`, 'info');
    
    if (!navigator.xr) {
        log('❌ navigator.xr 없음! 먼저 1단계 검사를 실행하세요', 'err');
        return;
    }
    
    try {
        // 세션 옵션 (Quest Guardian 문제 방지)
        const sessionInit = {
            optionalFeatures: ['local-floor']  // bounded-floor 제거로 Guardian 문제 방지
        };
        
        log('세션 요청 전송 중...', 'info');
        const session = await navigator.xr.requestSession(mode, sessionInit);
        log('✅ XR 세션 생성 성공!', 'ok');
        
        // 렌더러에 세션 연결
        await renderer.xr.setSession(session);
        log('✅ 렌더러 연결 완료!', 'ok');
        
        // UI 전환
        document.querySelector('h1').style.display = 'none';
        document.getElementById('log-container').style.display = 'none';
        statusDiv.style.display = 'none';
        document.querySelectorAll('.btn').forEach(btn => btn.style.display = 'none');
        renderer.domElement.style.display = 'block';
        
        log('🥽 VR 모드 진입 완료! 오른손 컨트롤러를 움직여보세요', 'ok');
        
        // 세션 종료 이벤트
        session.addEventListener('end', () => {
            log('VR 세션 종료됨', 'warn');
            // UI 복원
            document.querySelector('h1').style.display = 'block';
            document.getElementById('log-container').style.display = 'block';
            statusDiv.style.display = 'block';
            document.querySelectorAll('.btn').forEach(btn => btn.style.display = 'block');
            renderer.domElement.style.display = 'none';
            
            statusDiv.textContent = 'VR 세션 종료됨 - 다시 시작하려면 버튼 클릭';
            statusDiv.style.background = 'rgba(255, 152, 0, 0.3)';
        });
        
    } catch (error) {
        log(`❌ XR 세션 실패: ${error.name}: ${error.message}`, 'err');
        
        // 구체적인 에러별 해결책
        switch (error.name) {
            case 'NotSupportedError':
                log('→ immersive-vr 미지원. 3단계 inline 모드를 시도하세요', 'warn');
                break;
            case 'SecurityError':
                log('→ 보안 오류. HTTPS 주소 재확인 필요', 'warn');
                break;
            case 'NotAllowedError':
                log('→ 사용자 권한 거부. Quest에서 VR 권한을 허용하세요', 'warn');
                break;
            case 'InvalidStateError':
                log('→ 이미 XR 세션이 실행 중입니다', 'warn');
                break;
            default:
                log('→ Quest 가디언(안전 경계) 설정을 확인하세요', 'warn');
                log('→ Quest를 재부팅 후 다시 시도해보세요', 'warn');
        }
        
        statusDiv.textContent = `❌ VR 시작 실패: ${error.name}`;
        statusDiv.style.background = 'rgba(244, 67, 54, 0.4)';
    }
}

// ==========================================
// 버튼 이벤트 연결
// ==========================================
document.getElementById('btn-vr').addEventListener('click', () => {
    startXRSession('immersive-vr');
});

document.getElementById('btn-inline').addEventListener('click', () => {
    startXRSession('inline');
});

document.getElementById('btn-ws').addEventListener('click', () => {
    log('WebSocket 재연결 시도...', 'info');
    if (ws) ws.close();
    setTimeout(connectWebSocket, 1000);
});

// ==========================================
// 데이터 전송 루프 (30Hz)
// ==========================================
let lastSendTime = 0;
const SEND_RATE = 1000 / 30; // 30Hz

renderer.setAnimationLoop((time) => {
    // VR 모드에서 컨트롤러 데이터 전송
    if (renderer.xr.isPresenting && ws && ws.readyState === WebSocket.OPEN) {
        if (time - lastSendTime >= SEND_RATE) {
            
            // 오른손 컨트롤러 데이터
            if (rightController.visible) {
                const pos = rightController.position;
                const quat = rightController.quaternion;
                
                try {
                    ws.send(JSON.stringify({
                        hand: 'right',
                        x: pos.x, y: pos.y, z: pos.z,
                        qx: quat.x, qy: quat.y, qz: quat.z, qw: quat.w,
                        timestamp: time
                    }));
                } catch (error) {
                    log(`WebSocket 전송 에러: ${error.message}`, 'err');
                }
            }
            
            lastSendTime = time;
        }
    }
    
    renderer.render(scene, camera);
});

// 초기화 완료
log('🎯 초기화 완료! 1단계 검사부터 시작하세요', 'ok');
statusDiv.textContent = '✅ 준비 완료 - 1단계 검사를 시작하세요';

</script>
</body>
</html>
    """
    return web.Response(text=html, content_type='text/html')
