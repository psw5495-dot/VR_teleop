# 1. 깨끗하게 시작
cd ~/TeleVision
rm -rf models/g1
mkdir -p models/g1
cd models/g1

# 2. 공식 Unitree ROS 2 저장소 클론
git clone --depth 1 https://github.com/unitreerobotics/unitree_ros2.git temp_official

# 3. 실제 구조 확인 (중요!)
find temp_official -name "*g1*" -type f
find temp_official -name "*.urdf"

# 4. G1 모델 파일 복사 (실제 경로에 맞게)
if [ -d "temp_official/robots/g1_description" ]; then
    cp -r temp_official/robots/g1_description/* .
    echo "✅ g1_description 복사 성공"
elif [ -f "temp_official/robots/g1.urdf" ]; then
    cp temp_official/robots/g1.urdf .
    echo "✅ g1.urdf 직접 복사 성공"
else
    echo "❌ G1 파일을 찾을 수 없습니다. 구조를 확인합니다:"
    find temp_official -maxdepth 3 -type d
fi

# 5. 임시 폴더 삭제
rm -rf temp_official

# 6. 성공 확인
ls -la urdf/g1.urdf 2>/dev/null && echo "✅ URDF 파일 준비 완료!" || echo "⚠️ 다른 방법 시도 필요"
