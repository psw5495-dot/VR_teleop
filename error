# 단순 파지 동작에서는 좌우 벌림/모음 관절은 크게 움직이지 않도록 제외
# 기존 예제 기준 유지
SKIP_MOVE_JOINT_INDEX = [3, 6, 10, 14, 17, 19]
 
# 고정할 관절 각도, degree 단위
# 0: Thumb CMC Flexion/Extension
# 1: Thumb CMC Abduction/Adduction
FIXED_JOINT_DEG = {
    0: 85,   # Thumb CMC FE 고정 각도
    1: -18,   # Thumb CMC AA 고정 각도
}
 
 
# 안전 제한값
SAFE_INITIAL_CURRENT_COEFF = 0.3
SAFE_RELEASE_CURRENT_COEFF = 0.3
 
# 처음부터 1.0까지 올리는 것은 위험할 수 있으므로 코드상 상한을 둠
MAX_ALLOWED_CURRENT_COEFF = 0.9
 
 
def auto_detect_hand() -> Any:
    """
    Automatically detect Sharpa Wave device and connect to the first found device.
 
    Returns:
        hand object returned by manager.connect(sn)
    """
    print("Searching for devices...")
 
    try:
        manager = SharpaWaveManager.get_instance()
 
        # Wait for device discovery
        time.sleep(1.0)
 
        while True:
            devices = manager.get_all_device_sn()
 
            if not devices:
                print("No available devices found. Retrying...")
                time.sleep(1.0)
                continue
 
            print(f"Device found: {devices[0]}")
            hand = manager.connect(devices[0])
            return hand
 
    except Exception as e:
        print(f"Failed to connect to device: {str(e)}")
        raise
 
 
def initialize(hand) -> bool:
    """
    Initialize hand control parameters.
    """
    print("Initializing hand...")
 
    error = hand.set_control_mode(ControlMode.POSITION)
    if error.code != 0:
        print(f"Failed to set control mode: {error.message}")
        return False
 
    # 낮은 속도로 시작
    error = hand.set_speed_coeff(0.3)
    if error.code != 0:
        print(f"Failed to set speed coeff: {error.message}")
        return False
 
    # 낮은 전류로 시작
    error = hand.set_current_coeff(SAFE_INITIAL_CURRENT_COEFF)
    if error.code != 0:
        print(f"Failed to set current coeff: {error.message}")
        return False
 
    # SDK에서 제어하도록 설정
    error = hand.set_control_source(ControlSource.SDK)
    if error.code != 0:
        print(f"Failed to set control source: {error.message}")
        return False
 
    print("Hand initialization complete")
    return True
 
 
def check_error(error, message: str) -> bool:
    """
    SDK error object checker.
    """
    if error.code != 0:
        print(f"{message}: {error.message}")
        return False
    return True
 
 
def print_joint_positions_degree(hand):
    """
    Print current joint positions in degree.
    """
    error, angles = hand.get_joint_position_degree()
 
    if error.code != 0:
        print(f"Failed to get joint position(degree): {error.message}")
        return
 
    print("Current joint angles(deg):")
    for i, angle in enumerate(angles):
        joint_name = JOINT_NAMES[i] if i < len(JOINT_NAMES) else f"Joint {i}"
        print(f"  {i:02d} | {joint_name}: {angle:.2f}")
 
 
def set_hand_open(hand, interpolation: bool = True) -> bool:
    """
    Open hand by setting joints to open pose.
    Fixed joints are kept at FIXED_JOINT_DEG.
    """
    print("Opening hand...")
 
    open_pose = [0.0] * 22
 
    # 고정 관절은 open 동작에서도 지정 각도로 유지
    for joint_index, fixed_deg in FIXED_JOINT_DEG.items():
        open_pose[joint_index] = math.radians(fixed_deg)
 
    error = hand.set_joint_position(open_pose, interpolation)
 
    return check_error(error, "Failed to open hand")
 
def make_grasp_pose(close_ratio: float = 0.6) -> List:
    """
    Create grasp pose.
 
    Args:
        close_ratio:
            0.0 = opened pose near lower angle
            1.0 = closed pose near upper angle
 
    Returns:
        angle_list in radians, length 22
    """
    close_ratio = max(0.0, min(1.0, close_ratio))
 
    angle_list = [0.0] * 22
 
    for i in range(22):
        # 1. 고정 관절은 항상 지정한 값으로 유지
        if i in FIXED_JOINT_DEG:
            angle_list[i] = math.radians(FIXED_JOINT_DEG[i])
            continue
 
        # 2. 움직이지 않을 관절은 0도로 유지
        if i in SKIP_MOVE_JOINT_INDEX:
            angle_list[i] = 0.0
            continue
 
        # 3. 나머지 관절은 close_ratio에 따라 닫기
        lo_deg, hi_deg = ANGLE_RANGES[i]
        target_angle_deg = lo_deg + (hi_deg - lo_deg) * close_ratio
        angle_list[i] = math.radians(target_angle_deg)
 
    return angle_list
 
 
def set_grasp_pose(
    hand,
    close_ratio: float = 0.6,
    interpolation: bool = True,
) -> bool:
    """
    Move hand to grasp pose.
 
    Args:
        close_ratio:
            0.0 = open
            1.0 = maximum angle from ANGLE_RANGES
        interpolation:
            True means smooth movement if SDK supports interpolation mode.
    """
    print(f"Moving to grasp pose. close_ratio={close_ratio:.2f}")
 
    grasp_pose = make_grasp_pose(close_ratio)
    error = hand.set_joint_position(grasp_pose, interpolation)
 
    return check_error(error, "Failed to set grasp pose")
 
 
def ramp_current_for_strong_grip(
    hand,
    start_coeff: float = 0.3,
    end_coeff: float = 0.8,
    step: float = 0.1,
    step_hold_s: float = 0.5,
) -> bool:
    """
    Gradually increase current coefficient.
 
    This is safer than setting high current instantly.
 
    Args:
        start_coeff:
            Starting current coefficient.
        end_coeff:
            Target current coefficient.
            Code clamps this value to MAX_ALLOWED_CURRENT_COEFF.
        step:
            Increase amount per step.
        step_hold_s:
            Holding time for each step.
    """
    if step <= 0:
        print("Invalid step. step should be positive.")
        return False
 
    end_coeff = min(end_coeff, MAX_ALLOWED_CURRENT_COEFF)
    start_coeff = max(0.0, min(start_coeff, end_coeff))
 
    coeff = start_coeff
 
    print(
        f"Ramping current coeff from {start_coeff:.2f} "
        f"to {end_coeff:.2f}, step={step:.2f}"
    )
 
    while coeff <= end_coeff + 1e-9:
        print(f"Setting current coeff: {coeff:.2f}")
 
        error = hand.set_current_coeff(coeff)
        if error.code != 0:
            print(f"Failed to set current coeff {coeff:.2f}: {error.message}")
            return False
 
        time.sleep(step_hold_s)
        coeff += step
 
    return True
 
 
def grasp_object_strongly(
    hand,
    pre_grasp_ratio: float = 0.45,
    grasp_ratio: float = 0.45,
    final_current_coeff: float = 0.8,
    hold_time_s: float = 3.0,
) -> bool:
    """
    Strong grasp sequence.
 
    Sequence:
        1. Set low current
        2. Open hand
        3. Move to pre-grasp pose
        4. Move to deeper grasp pose
        5. Gradually increase current
        6. Hold object
        7. Reduce current
        8. Open hand
 
    Args:
        pre_grasp_ratio:
            Initial closing ratio before strong grasp.
        grasp_ratio:
            Final closing ratio around object.
        final_current_coeff:
            Final current coefficient.
            Clamped by MAX_ALLOWED_CURRENT_COEFF.
        hold_time_s:
            Holding time after current ramp.
    """
    interpolation = True
 
    print("========== Strong Grasp Sequence Start ==========")
 
    final_current_coeff = min(final_current_coeff, MAX_ALLOWED_CURRENT_COEFF)
 
    # 1. 낮은 전류로 시작
    print("[1] Set initial low current")
    error = hand.set_current_coeff(SAFE_INITIAL_CURRENT_COEFF)
    if not check_error(error, "Failed to set initial current coeff"):
        return False
 
    time.sleep(0.3)
 
    # 2. 손 열기
    print("[2] Open hand")
    if not set_hand_open(hand, interpolation):
        return False
 
    time.sleep(1.0)
 
    # 3. 물체 접근용 pre-grasp 자세
    print("[3] Move to pre-grasp pose")
    if not set_grasp_pose(hand, close_ratio=pre_grasp_ratio, interpolation=interpolation):
        return False
 
    time.sleep(1.0)
 
    # 4. 물체를 감싸는 grasp 자세
    print("[4] Move to grasp pose")
    if not set_grasp_pose(hand, close_ratio=grasp_ratio, interpolation=interpolation):
        return False
 
    time.sleep(1.0)
 
    # 5. 전류 계수 단계적 증가
    print("[5] Increase grip current gradually")
    if not ramp_current_for_strong_grip(
        hand,
        start_coeff=0.4,
        end_coeff=final_current_coeff,
        step=0.1,
        step_hold_s=0.5,
    ):
        return False
 
    # 6. 꽉 쥔 상태 유지
    print(f"[6] Holding object for {hold_time_s:.1f} seconds")
    time.sleep(hold_time_s)
 
    print_joint_positions_degree(hand)
 
    # 7. 손을 열기 전에 전류 낮추기
    print("[7] Reduce current before release")
    error = hand.set_current_coeff(SAFE_RELEASE_CURRENT_COEFF)
    check_error(error, "Failed to reduce current coeff")
 
    time.sleep(0.5)
 
    # 8. 손 열기
    print("[8] Open hand")
    set_hand_open(hand, interpolation)
 
    time.sleep(1.0)
 
    print("========== Strong Grasp Sequence Finished ==========")
    return True
 
 
def safe_shutdown(hand):
    """
    Try to safely release hand and disconnect all devices.
    """
    print("Safe shutdown started")
 
    try:
        if hand is not None:
            # 전류 낮추기
            try:
                hand.set_current_coeff(SAFE_RELEASE_CURRENT_COEFF)
            except Exception as e:
                print(f"Warning: failed to reduce current coeff during shutdown: {e}")
 
            # 손 열기
            try:
                hand.set_joint_position([0.0] * 22, True)
                time.sleep(1.0)
            except Exception as e:
                print(f"Warning: failed to open hand during shutdown: {e}")
 
            # hand stop
            try:
                hand.stop()
            except Exception as e:
                print(f"Warning: failed to stop hand: {e}")
 
    finally:
        try:
            SharpaWaveManager.get_instance().disconnect_all()
        except Exception as e:
            print(f"Warning: failed to disconnect all: {e}")
 
    print("Safe shutdown complete")
 
 
if __name__ == "__main__":
    hand = None
 
    try:
        print("Sharpa Wave Example - Auto Detect Hand")
 
        hand = auto_detect_hand()
 
        if hand is None:
            print("Error: No available device found")
            sys.exit(1)
 
        print("Sharpa Wave Example - Init Hand Running Mode")
 
        if not initialize(hand):
            print("Error: Failed to initialize hand")
            sys.exit(1)
 
        print("Sharpa Wave Example - Start Hand Running Mode")
        hand.start()
 
        # 시작 전 초기 위치
        set_hand_open(hand, interpolation=True)
        time.sleep(1.0)
 
        print("Sharpa Wave Example - Run Strong Grasp")
 
        # 처음 테스트 시 아래 값을 낮게 잡는 것을 권장:
        # pre_grasp_ratio=0.35~0.45
        # grasp_ratio=0.50~0.65
        # final_current_coeff=0.5~0.7
        #
        # 점진적으로 올리고 싶으면:
        # grasp_ratio=0.75
        # final_current_coeff=0.8 또는 0.9
        success = grasp_object_strongly(
            hand,
            pre_grasp_ratio=0.20,
            grasp_ratio=0.35,
            final_current_coeff=0.4,
            hold_time_s=2.0,
        )
 
        if not success:
            print("Strong grasp sequence failed")
            sys.exit(1)
 
        print("Sharpa Wave Example - Completed Successfully")
 
    except KeyboardInterrupt:
        print("\nKeyboardInterrupt received. Stopping safely...")
 
    except Exception as e:
        print(f"Unexpected error: {e}")
 
    finally:
        safe_shutdown(hand)
        print("Sharpa Wave Example - Stopped")
