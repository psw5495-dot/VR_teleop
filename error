def detect_stall(prev_angles: List[float], curr_angles: List[float]) -> bool:
    """관절 움직임을 분석하여 stall을 감지합니다."""
    active_joints = [i for i in range(NUM_JOINTS) 
                    if i not in Config.SKIP_MOVE_JOINT_INDICES 
                    and i not in Config.FIXED_JOINT_DEG]
    
    max_movement = max(
        abs(curr_angles[i] - prev_angles[i]) 
        for i in active_joints 
        if i < len(curr_angles) and i < len(prev_angles)
    )
    
    return max_movement < Config.STALL_THRESHOLD_DEG


