# =============================================================================
# Configuration - 모든 파라미터와 설정값
# =============================================================================

class Config:
    """Sharpa Wave 강한 파지 제어를 위한 모든 설정값들"""
    
    # -------------------------------------------------------------------------
    # 파지 시퀀스 파라미터 (실험 시 주로 조정하는 값들)
    # -------------------------------------------------------------------------
    PRE_GRASP_RATIO = 0.20          # 물체 접근 시 예비 파지 비율 (0.0~1.0)
    GRASP_RATIO = 0.35              # 물체를 감싸는 최종 파지 비율 (0.0~1.0)
    FINAL_CURRENT_COEFF = 0.4       # 강한 파지 시 목표 전류 계수 (처음엔 0.4~0.7 권장)
    HOLD_TIME_S = 2.0               # 파지 상태 유지 시간 (초)
    
    # -------------------------------------------------------------------------
    # 안전 제한값 (함부로 변경하지 말 것)
    # -------------------------------------------------------------------------
    SAFE_INITIAL_CURRENT_COEFF = 0.3    # 초기화 시 안전 전류 계수
    SAFE_RELEASE_CURRENT_COEFF = 0.3     # 해제 시 안전 전류 계수
    MAX_ALLOWED_CURRENT_COEFF = 0.9      # 코드상 전류 계수 상한 (1.0은 위험)
    INITIAL_SPEED_COEFF = 0.3            # 초기 속도 계수
    
    # -------------------------------------------------------------------------
    # 전류 점진적 증가 설정
    # -------------------------------------------------------------------------
    RAMP_START_COEFF = 0.4          # 전류 증가 시작점
    RAMP_STEP = 0.1                 # 전류 증가 스텝 크기
    RAMP_STEP_HOLD_S = 0.5          # 각 스텝 유지 시간 (초)
    
    # -------------------------------------------------------------------------
    # 시퀀스 타이밍 (각 단계별 대기 시간)
    # -------------------------------------------------------------------------
    DELAY_AFTER_INIT = 0.3          # 초기화 후 대기
    DELAY_AFTER_OPEN = 1.0          # 손 열기 후 대기
    DELAY_AFTER_PRE_GRASP = 1.0     # 예비 파지 후 대기
    DELAY_AFTER_GRASP = 1.0         # 본 파지 후 대기
    DELAY_AFTER_CURRENT_REDUCE = 0.5 # 전류 감소 후 대기
    
    # -------------------------------------------------------------------------
    # 관절 제어 설정
    # -------------------------------------------------------------------------
    # 파지 시 움직이지 않을 관절들 (좌우 벌림/모음 관절)
    SKIP_MOVE_JOINT_INDICES = [3, 6, 10, 14, 17, 19]
    
    # 항상 고정할 관절과 각도 (degree)
    FIXED_JOINT_DEG = {
        0: 85,   # Thumb CMC Flexion/Extension
        1: -18,  # Thumb CMC Abduction/Adduction
    }


